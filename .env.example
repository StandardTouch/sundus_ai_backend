# ============================================
# Server Configuration
# ============================================
PORT=3000
NODE_ENV=development

# ============================================
# OpenAI Configuration
# ============================================
# Your OpenAI API key for GPT-4 and embeddings
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI Model Configuration (optional, defaults will be used if not set)
# OPENAI_MODEL=gpt-4
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ============================================
# AI Sensy WhatsApp API Configuration
# ============================================
# AI Sensy Partner API Key (used in X-AiSensy-Partner-API-Key header)
AISENSY_API_KEY=your-aisensy-api-key-here

# AI Sensy Project ID (used in API endpoints)
AISENSY_PROJECT_ID=655b383d2c1f7c51b62a7338

# AI Sensy API Base URL (optional, defaults to https://apis.aisensy.com)
AISENSY_API_BASE_URL=https://apis.aisensy.com

# Webhook secret for verifying incoming webhooks from AI Sensy
AISENSY_WEBHOOK_SECRET=your-webhook-secret-here

# Request timeout in milliseconds (optional, default: 10000)
AISENSY_TIMEOUT=10000

# ============================================
# MongoDB Database Configuration
# ============================================
# MongoDB connection string
# Format: mongodb://[username:password@]host[:port][/database][?options]
MONGODB_URI=mongodb://localhost:27017/sundus_ai
MONGODB_DB_NAME=sundus_ai

# MongoDB connection options (optional)
# MONGODB_OPTIONS={}

# ============================================
# Pinecone Vector Database Configuration
# ============================================
# Pinecone API key for vector database access
PINECONE_API_KEY=your-pinecone-api-key-here

# Pinecone environment/region
PINECONE_ENVIRONMENT=us-east-1-aws

# Pinecone index name for FAQ embeddings
PINECONE_INDEX_NAME=sundus-faqs

# Pinecone namespace (optional, for organizing data)
# PINECONE_NAMESPACE=faqs

# ============================================
# Alhomaidhi Group API Configuration
# ============================================
# Base URL for Alhomaidhi Group API
ALHOMAIDHI_API_BASE_URL=https://alhomaidhigroup.com/wp-json/alhomaidhiapp/v2

# API Key for public endpoints (products, brands)
ALHOMAIDHI_API_KEY=550699352X72qodSOlbkS6exhCg4KM8ACjJkg3ZKz2Y6138rjtXG47XNSoM

# Default user_id for API requests (optional)
ALHOMAIDHI_DEFAULT_USER_ID=66

# ============================================
# Application Configuration
# ============================================
# Number of negative feedbacks before escalating to human agent
ESCALATION_THRESHOLD=3

# OTP expiry time in minutes
OTP_EXPIRY_MINUTES=5

# Maximum OTP requests per phone number per hour
OTP_RATE_LIMIT=3

# FAQ similarity threshold (0-1) for matching user queries
# If similarity score is above this, return FAQ answer; otherwise use OpenAI
FAQ_SIMILARITY_THRESHOLD=0.85

# Maximum number of FAQ results to return
FAQ_MAX_RESULTS=3

# ============================================
# AI FAQ Suggestions Configuration (optional)
# ============================================
# Enable AI FAQ suggestions from conversations
FAQ_SUGGESTION_ENABLED=true

# Minimum number of times a question must be asked before suggesting FAQ
FAQ_SUGGESTION_MIN_OCCURRENCES=3

# Minimum AI confidence score to suggest FAQ (0-1)
FAQ_SUGGESTION_MIN_CONFIDENCE=0.75

# Only suggest FAQs if user gave positive feedback
FAQ_SUGGESTION_REQUIRE_POSITIVE_FEEDBACK=true

# ============================================
# Rate Limiting Configuration (optional)
# ============================================
# Maximum messages per user per minute
RATE_LIMIT_MESSAGES_PER_MINUTE=10

# Maximum messages per user per hour
RATE_LIMIT_MESSAGES_PER_HOUR=100


# ============================================
# Logging Configuration
# ============================================
# Log level: error, warn, info, debug
LOG_LEVEL=info

# Enable request logging
LOG_REQUESTS=true

# Enable response logging (can be verbose)
LOG_RESPONSES=false

# Enable file logging (default: true in production, false in development)
ENABLE_FILE_LOGGING=true

# Log directory (default: ./logs)
LOG_DIR=./logs

JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=8h

# ============================================
# SMTP Email Configuration
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_EMAIL=info@alhomaidhi.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_FROM_NAME=Sundus AI
SMTP_TIMEOUT=10000

FRONTEND_URL=http://localhost:5173